{
  "name": "leadforge",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/** build && pnpm -r --filter=./apps/** build",
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @leadforge/api dev",
    "dev:worker": "pnpm --filter @leadforge/worker dev",
    "dev:web": "pnpm --filter @leadforge/web dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @leadforge/api test:e2e",
    "db:generate": "pnpm --filter @leadforge/database generate",
    "db:migrate": "pnpm --filter @leadforge/database migrate",
    "db:migrate:deploy": "pnpm --filter @leadforge/database migrate:deploy",
    "db:push": "pnpm --filter @leadforge/database push",
    "db:seed": "pnpm --filter @leadforge/database seed",
    "db:studio": "pnpm --filter @leadforge/database studio",
    "docker:up": "docker compose up -d postgres redis",
    "docker:down": "docker compose down",
    "stack:up": "docker compose up --build",
    "smoke": "node scripts/smoke-test.mjs",
    "services": "node scripts/dev-services.mjs start",
    "services:stop": "node scripts/dev-services.mjs stop",
    "services:status": "node scripts/dev-services.mjs status",
    "check:models": "node scripts/check-models.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^26.4.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "puppeteer-core": "^25.10.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^7.1.14",
    "vitest": "^3.2.6"
  }
}
