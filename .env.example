# ---------------------------------------------------------------------------
# LeadForge AI — environment reference (see docs/35-ENVIRONMENT.md)
# Copy to .env and fill in. Never commit a populated .env.
# ---------------------------------------------------------------------------

# Runtime
APP_ENV=development
LOG_LEVEL=info
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
WORKER_PORT=4001
CORS_ORIGINS=http://localhost:3000

# Datastores
# Host ports are offset from the defaults so this stack can run alongside others.
POSTGRES_PORT=5462
REDIS_PORT=6389
DATABASE_URL=postgresql://leadforge:leadforge@localhost:5462/leadforge?schema=public
REDIS_URL=redis://localhost:6389

# Auth — generate with: openssl rand -hex 32
AUTH_SECRET=change-me-development-secret-change-me-32
SESSION_TTL_HOURS=720
COOKIE_DOMAIN=
COOKIE_SECURE=false

# AI gateway (server-side only; never expose to the browser)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_ENABLED=true
AI_MONTHLY_USD_BUDGET=50
AI_DEFAULT_TIER=balanced

# Discovery
GOOGLE_MAPS_API_KEY=
DISCOVERY_MAX_RESULTS_PER_RUN=200

# Meta / WhatsApp / Instagram
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
META_GRAPH_VERSION=v21.0

# Email outreach (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Object storage (optional)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Enrichment fetcher safety limits
FETCH_TIMEOUT_MS=8000
FETCH_MAX_BYTES=2000000
FETCH_MAX_REDIRECTS=3
ALLOW_PRIVATE_NETWORK_FETCH=false

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=leadforge

# Reply capture for email outreach (optional). Point an inbound-parse provider
# (Postmark is the tested shape) for INBOUND_EMAIL_DOMAIN at
# <API_URL>/webhooks/inbound-email, authenticating with the secret as the HTTP
# basic-auth password or an X-Inbound-Secret header. When both are set, outreach
# email is sent with a Reply-To on that domain and replies land in Conversations.
INBOUND_EMAIL_DOMAIN=
INBOUND_EMAIL_SECRET=

# Billing (Paddle). Leave blank to run without self-serve payment; every value
# must be set before upgrades are offered. Point the Paddle webhook at
# <API_URL>/billing/webhook and subscribe it to the subscription.* events.
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_CLIENT_TOKEN=
PADDLE_PRICE_STARTER=
PADDLE_PRICE_GROWTH=
PADDLE_PRICE_AGENCY=

# Rate limiting (requests per window, per session or address)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20

# Frontend (public)
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public site URL, used for absolute links in page metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Named on the terms and privacy pages.
NEXT_PUBLIC_LEGAL_ENTITY=
NEXT_PUBLIC_SUPPORT_EMAIL=
