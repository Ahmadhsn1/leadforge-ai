# syntax=docker/dockerfile:1

# ---------------------------------------------------------------------------
# LeadForge backend as one container: the HTTP API and the queue workers in a
# single process (apps/worker/src/server.ts).
#
# Vercel builds this file when a project's root directory is the repository
# root. The web app is a separate project rooted at apps/web and never sees it.
#
# Read before relying on it: Vercel runs containers as functions that scale to
# zero after a few idle minutes. Queued and delayed jobs — pipeline stages,
# scheduled sends, follow-up sequences — only advance while an instance is
# awake. For a backend that must keep working with nobody signed in, run this
# same image on a host that keeps one instance up.
# ---------------------------------------------------------------------------

FROM node:22-alpine AS base
RUN corepack enable && apk add --no-cache libc6-compat openssl
WORKDIR /app

# --- deps: manifests first, so a source change does not reinstall ----------
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY packages/config/package.json ./packages/config/
COPY packages/shared/package.json ./packages/shared/
COPY packages/database/package.json ./packages/database/
COPY packages/ai/package.json ./packages/ai/
COPY apps/api/package.json ./apps/api/
COPY apps/worker/package.json ./apps/worker/
RUN pnpm install --frozen-lockfile --filter @leadforge/worker...

# --- build ----------------------------------------------------------------
FROM deps AS build
COPY tsconfig.base.json ./
COPY packages ./packages
COPY apps/api ./apps/api
COPY apps/worker ./apps/worker
RUN pnpm --filter @leadforge/database generate \
 && pnpm --filter @leadforge/config build \
 && pnpm --filter @leadforge/shared build \
 && pnpm --filter @leadforge/database build \
 && pnpm --filter @leadforge/ai build \
 && pnpm --filter @leadforge/api build \
 && pnpm --filter @leadforge/worker build

# --- runtime --------------------------------------------------------------
# The build tree is carried over whole rather than pruned to production
# dependencies: the Prisma CLI is a dev dependency, and it is what applies
# migrations on start. A larger image is the price of that being reliable.
FROM base AS runtime
ENV NODE_ENV=production
COPY --from=build /app ./

USER node

# An unprivileged user cannot be relied on to bind port 80. Set PORT=8080 in
# the Vercel project's environment variables too, so its router sends traffic
# to the port this process listens on; server.ts honours PORT.
ENV PORT=8080
EXPOSE 8080

# Migrations are applied before the server accepts traffic. `migrate deploy`
# is idempotent and takes an advisory lock, so concurrent cold starts are safe.
CMD ["sh", "-c", "node packages/database/node_modules/prisma/build/index.js migrate deploy --schema packages/database/prisma/schema.prisma && node apps/worker/dist/server.js"]
